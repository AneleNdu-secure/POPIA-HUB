# ==============================================================================
# POPIA Hub - Database Configuration (Supabase PostgreSQL)
# Project Ref: hqeasukxzofottyeeccp
# Region: Central EU - Frankfurt (eu-central-1)
# ==============================================================================

# 1. Transaction Pooler Connection String (Port 6543)
# Used by runtime queries and the application connection pool (pg.Pool).
# Supavisor / PgBouncer manages high-concurrency client connections and serverless scaling.
DATABASE_URL=postgresql://postgres.hqeasukxzofottyeeccp:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 2. Direct Database Connection String (Port 5432)
# Used exclusively by Drizzle Kit for schema migrations (db:migrate), push (db:push), and DDL operations.
# Bypasses PgBouncer transaction-pooler locks, enabling advisory locks and full DDL execution.
DIRECT_URL=postgresql://postgres:[j2SE3q47CA/5_c3D]@db.hqeasukxzofottyeeccp.supabase.co:5432/postgres

# Alternative IPv4 Session Pooler URI (Port 5432)
# Use this if your local ISP or container network does not have outbound IPv6 routing to db.*.supabase.co:
# DIRECT_URL=postgresql://postgres.hqeasukxzofottyeeccp:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ==============================================================================
# Connection Pool & SSL Settings
# ==============================================================================
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_SSL=true
